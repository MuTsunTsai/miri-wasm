+++ b/src/tools/miri/src/shims/unix/wasi_net.rs
@@ -0,0 +1,99 @@
+//! Stand-ins for host networking when Miri itself runs on `wasm32-wasip1`.
+//!
+//! `socket2` refuses to compile for wasip1 and `mio` has no `UdpSocket` on WASI, so the
+//! real `tcp_socket` / `udp_socket` modules are left out on that host. `socket.rs` still
+//! compiles against the tiny `socket2` facade below; creating a host socket always fails
+//! with `Unsupported`, so the facade's `SockRef` can never actually be constructed.
+
+use std::io;
+
+use crate::shims::unix::UnixFileDescription;
+use crate::shims::FileDescriptionRef;
+use crate::*;
+
+pub mod socket2 {
+    use std::convert::Infallible;
+    use std::io;
+    use std::marker::PhantomData;
+    use std::time::Duration;
+
+    #[derive(Clone, Copy, PartialEq, Eq, Debug)]
+    pub struct Domain(i32);
+
+    impl Domain {
+        pub const IPV4: Domain = Domain(2);
+        pub const IPV6: Domain = Domain(10);
+    }
+
+    /// Uninhabited: there is never an underlying host socket on wasip1.
+    pub struct SockRef<'a>(Infallible, PhantomData<&'a ()>);
+
+    impl SockRef<'_> {
+        pub fn set_reuse_address(&self, _: bool) -> io::Result<()> {
+            match self.0 {}
+        }
+        pub fn reuse_address(&self) -> io::Result<bool> {
+            match self.0 {}
+        }
+        pub fn set_linger(&self, _: Option<Duration>) -> io::Result<()> {
+            match self.0 {}
+        }
+        pub fn linger(&self) -> io::Result<Option<Duration>> {
+            match self.0 {}
+        }
+        pub fn set_keepalive(&self, _: bool) -> io::Result<()> {
+            match self.0 {}
+        }
+        pub fn keepalive(&self) -> io::Result<bool> {
+            match self.0 {}
+        }
+        pub fn set_ttl_v4(&self, _: u32) -> io::Result<()> {
+            match self.0 {}
+        }
+        pub fn ttl_v4(&self) -> io::Result<u32> {
+            match self.0 {}
+        }
+        pub fn set_tcp_nodelay(&self, _: bool) -> io::Result<()> {
+            match self.0 {}
+        }
+        pub fn tcp_nodelay(&self) -> io::Result<bool> {
+            match self.0 {}
+        }
+    }
+}
+
+/// Uninhabited placeholder for a host socket file description.
+pub enum NoSocket {}
+
+impl NoSocket {
+    pub fn as_unix(self) -> FileDescriptionRef<dyn UnixFileDescription> {
+        match self {}
+    }
+}
+
+fn unsupported() -> io::Error {
+    io::Error::new(io::ErrorKind::Unsupported, "host sockets are not supported on wasm32-wasip1")
+}
+
+pub struct TcpSocket;
+pub struct UdpSocket;
+
+impl TcpSocket {
+    pub fn new<'tcx>(
+        _family: socket2::Domain,
+        _is_non_block: bool,
+        _ecx: &mut MiriInterpCx<'tcx>,
+    ) -> io::Result<NoSocket> {
+        Err(unsupported())
+    }
+}
+
+impl UdpSocket {
+    pub fn new<'tcx>(
+        _family: socket2::Domain,
+        _is_non_block: bool,
+        _ecx: &mut MiriInterpCx<'tcx>,
+    ) -> io::Result<NoSocket> {
+        Err(unsupported())
+    }
+}
